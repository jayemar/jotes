<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Android status-bar icons use only this shape's alpha channel (the
         OS silhouettes/tints it itself), so the stroke color below is
         irrelevant on-device and only matters for previewing this file. -->
    <!-- Pentagram: 5 points on a circle, connected in {5/2} order (every
         second point) rather than filled, so the crossing lines - and the
         small pentagon they trace in the middle - stay visible, unlike a
         plain filled 5-point star. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,2.8 L6.59,19.44 L20.75,9.16 L3.25,9.16 L17.41,19.44 Z" />
</vector>
